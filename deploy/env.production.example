# Réglages de la VRAIE boutique Zado (fichier .env sur le serveur ; jamais sur GitHub).
# Créé par deploy/installer.sh ; à compléter ensuite avec : sudo -u zado nano /srv/zado/app/.env
# puis redémarrer : sudo systemctl restart zado

PORT=3000
PUBLIC_URL=https://__DOMAIN__
# nginx est devant la boutique : vraie adresse IP des clients (limites anti-abus)
TRUST_PROXY=1

# Paiements RÉELS. Sans compte marchand MTN / Airtel, seul le « dépôt » sur le numéro de Zado est proposé
# (numéros à saisir dans Zado Pro → Réglages → Transport, délais et acompte).
PAYMENT_MODE=live

# Clé de chiffrement des codes clients (générée à l'installation). NE JAMAIS la changer ni la perdre (elle est sauvegardée chaque nuit).
CUSTOMER_CODE_KEY=__CODE_KEY__
CRON_SECRET=__CRON__

# Alerte e-mail à chaque commande (ex. Gmail : smtp.gmail.com, port 465, « mot de passe d'application »)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=

# Compte marchand MTN MoMo (Collection API, production : MTN_TARGET_ENV=mtncongo, MTN_CURRENCY=XAF)
MTN_BASE_URL=https://proxy.momoapi.mtn.com
MTN_TARGET_ENV=mtncongo
MTN_CURRENCY=XAF
MTN_SUBSCRIPTION_KEY=
MTN_API_USER=
MTN_API_KEY=

# Compte marchand Airtel Money Congo
AIRTEL_BASE_URL=https://openapi.airtel.africa
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=

# Connexion « Continuer avec Google / Apple » (vides = boutons « bientôt »)
GOOGLE_CLIENT_ID=
APPLE_SERVICE_ID=
APPLE_REDIRECT_URI=https://__DOMAIN__/
