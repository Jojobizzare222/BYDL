# ---------- Général ----------
PORT=3000
# URL publique du site (utilisée pour les callbacks des opérateurs)
PUBLIC_URL=http://localhost:3000
SHOP_NAME=Baydel
CURRENCY=XAF
COUNTRY=CG

# ---------- Paiement ----------
# simulation : aucun appel réel, idéal pour développer
# live       : appels réels aux API MTN / Airtel (sandbox ou production selon les URLs ci-dessous)
PAYMENT_MODE=simulation
# Minutes pendant lesquelles une demande de paiement en attente bloque une nouvelle demande et réserve le stock
PAYMENT_PENDING_MINUTES=10
# Délai maximal d'attente d'une réponse de MTN / Airtel (millisecondes)
OPERATOR_TIMEOUT_MS=15000

# ---------- Alerte e-mail à chaque commande payée ----------
# Laisser vide pour tester : l'e-mail s'affiche alors dans le Terminal.
# Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=votre adresse Gmail,
#         SMTP_PASS=un « mot de passe d'application » Google (pas votre mot de passe habituel)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Adresse qui reçoit les alertes
ALERT_EMAIL_TO=

# ---------- MTN MoMo (API Collection) ----------
# Portail : https://momodeveloper.mtn.com
MTN_BASE_URL=https://sandbox.momodeveloper.mtn.com
# sandbox en test ; en production au Congo : mtncongo
MTN_TARGET_ENV=sandbox
MTN_SUBSCRIPTION_KEY=
MTN_API_USER=
MTN_API_KEY=
# La sandbox MTN n'accepte que EUR ; en production : XAF
MTN_CURRENCY=EUR

# ---------- Airtel Money (API Collection) ----------
# Portail : https://developers.airtel.africa
AIRTEL_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_COUNTRY=CG
AIRTEL_CURRENCY=XAF
